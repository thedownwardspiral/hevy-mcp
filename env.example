# Copy to .env next to compose.yml on the Docker host and fill in real values.
# .env is gitignored; never commit the filled-in copy.

# Image tag: latest, a release such as 1.2.0, or sha-<short sha>.
HEVY_MCP_TAG=latest

# Vault in k3s, as reached from the Docker host.
VAULT_ADDR=https://vault.<home-domain>
VAULT_APPROLE_MOUNT=approle
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=hevy-mcp

# Host paths of the AppRole credentials and the internal CA bundle.
VAULT_ROLE_ID_SOURCE=./secrets/vault_role_id
VAULT_SECRET_ID_SOURCE=./secrets/vault_secret_id
VAULT_CACERT_SOURCE=./secrets/vault-ca.pem

# Traefik: the hostname to route, its Docker network, the home-only entrypoint
# and whether that entrypoint serves TLS.
HEVY_MCP_HOSTNAME=hevy-mcp.home.example
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# Hostnames the server answers for, comma-separated: the public tunnel hostname
# (the tunnel sends it as the Host header) and the LAN hostname if Traefik
# routes one. Requests for any other host get 421. Leave empty to accept any.
MCP_ALLOWED_HOSTS=hevy-mcp.example.com,hevy-mcp.home.example

# Cloudflare Access (README step 6c): the team domain, the Access application's
# AUD tag, and the emails allowed to call the server, comma-separated. Leave all
# three empty until the Access application exists, then set all three, e.g.
#   CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
#   CF_ACCESS_AUD=<AUD tag>
#   CF_ACCESS_ALLOWED_EMAILS=you@gmail.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=

# Timezone for date-only tool inputs, and log level.
TZ=UTC
LOG_LEVEL=INFO
